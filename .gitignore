# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*egg-info/
dist/
build/
.eggs/

# ── Pixi ────────────────────────────────────────────────────────────────────
.pixi/
pixi.lock

# ── Model weights & checkpoints (large files — download separately, never commit) ──
*.pt
*.pth
*.safetensors
*.ckpt
*.bin
*.npy
*.npz

# Tiny LEAStereo NAS architecture descriptors (not data dumps — keep in repo)
!preprocessing/disparity_estimation/Leastereo/run/**/architecture/*.npy

# Explicit checkpoint directories
preprocessing/disparity_estimation/WAFT-Stereo/ckpts/
preprocessing/disparity_estimation/Leastereo/run/Kitti15/
preprocessing/disparity_estimation/Leastereo/run/**/best.pth
preprocessing/optical_flow_estimation/**/ckpts/
**/.cache/huggingface/

# ── Logs & outputs ──────────────────────────────────────────────────────────
/logs/
/ckpts/
/trainer/logs/
/trainer/ckpts/
/trainer/debugs/
/trainer/evaluation_results/
/trainer/results_visualizations/

# ── Data ────────────────────────────────────────────────────────────────────
/datasets/
/images/

# ── Misc ────────────────────────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
*.gif

# ── Keep these dotfiles ──────────────────────────────────────────────────────
!.gitattributes
!.gitignore
!.gitmodules
!.pre-commit-config.yaml
